export function getCreationPath(parentName: string, childName: string): string {
    // Basic mapping from parent type to its extra path (extracted from def.ts)
    switch (parentType) {
        case 'Package': {
            // Array von types
            // schau nach ob der child type dort eingefuegt werden kann
            if (['Class', 'Interface', ...].includes(childType)) { //eigentlich Zeile 78 - alle wo in extends Entity 
                return 'entities' //Zeile 82
            }
        }
        case 'Class': {
            // Array von types
            // schau nach ob der child type dort eingefuegt werden kann
            if (['Operation'].includes(childType)) {
                return 'operations'
            } else if (['Property'].includes(childType)) {
                return 'properties'
            }
        }
    }
}

